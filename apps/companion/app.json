{
  "expo": {
    "name": "Lead-Child",
    "slug": "lead-child-companion",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "lead-child",
    "userInterfaceStyle": "light",
    "ios": {
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Lead-Child connects to the Lead-Child daemon on your local network."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0E1630",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "package": "com.bytezard.plc",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#10131A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Scan the pairing QR code of the Lead-Child daemon on your computer, or take a photo to send to Lead.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose photos to send to Lead.",
          "cameraPermission": "Scan the pairing QR code of the Lead-Child daemon on your computer, or take a photo to send to Lead.",
          "microphonePermission": false
        }
      ],
      "expo-document-picker",
      "./plugins/withLanCleartext"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "locales": {
      "zh": "./locales/zh.json"
    }
  }
}
